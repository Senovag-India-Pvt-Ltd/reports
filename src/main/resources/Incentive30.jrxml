								<text><![CDATA[ವಹಿವಾಟು ಮಾಡಿದ ದ್ವಿತಳಿ ರೇಷ್ಮೆ ಗೂಡಿನ ಪ್ರಮಾಣ]]></text>
							</staticText>
						</jr:columnHeader>
						<jr:columnFooter style="Table_CH" height="20" rowSpan="1">
							<textField pattern="#,##0.000">
								<reportElement x="0" y="0" width="72" height="20" uuid="34f94b60-d341-4708-a4b9-262ff30822d3"/>
								<textElement textAlignment="Center" verticalAlignment="Middle">
									<font fontName="Nirmala UI" size="7"/>
								</textElement>
								<textFieldExpression><![CDATA[$V{cocoonsWeight2}]]></textFieldExpression>
							</textField>
						</jr:columnFooter>
						<jr:detailCell style="Table_TD" height="30">
							<textField pattern="#,##0.000">
								<reportElement x="0" y="0" width="72" height="30" uuid="afd120fa-8084-4d0f-87a5-d400066e3596"/>
