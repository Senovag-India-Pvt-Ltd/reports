								<reportElement x="0" y="0" width="90" height="40" uuid="68ab5b04-86eb-482c-b65e-e98882d37c47"/>
								<textElement textAlignment="Center" verticalAlignment="Middle">
									<font fontName="Nirmala UI" size="7"/>
								</textElement>
								<text><![CDATA[ಪ್ರತಿ ಕೆ.ಜಿ ದ್ವಿತಳಿ ಸಂಕರಣ ರೇಷ್ಮೆ ಗೂಡಿಗೆ ಪ್ರೋತ್ಸಾಹಧನ ದರ]]></text>
							</staticText>
						</jr:columnHeader>
