					</jr:column>
					<jr:column width="100" uuid="1bcb859e-50c2-4b0a-8832-052c4825b711">
						<property name="com.jaspersoft.studio.components.table.model.column.name" value="Column9"/>
						<jr:columnHeader style="Table_CH" height="40" rowSpan="1">
							<staticText>
								<reportElement x="0" y="0" width="100" height="40" uuid="c1b2ee80-fb8e-4c63-a1d3-0555334abb3d"/>
								<textElement textAlignment="Center" verticalAlignment="Middle">
									<font fontName="Nirmala UI" size="7"/>
								</textElement>
								<text><![CDATA[ಪ್ರೋತ್ಸಾಹ ದಾನಕ್ಕೆ ಅರ್ಹ ಗೂಡಿನ ಪ್ರಮಾಣಕ್ಕೆ ಗೂಡಿನ ಮೊತ್ತ ( ಪ್ರತಿ 100 ಮೊಟ್ಟೆಗೆ 60 ರಿಂದ 90 ರಂತೆ)]]></text>
							</staticText>
						</jr:columnHeader>
