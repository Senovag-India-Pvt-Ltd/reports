					<paragraph leftIndent="2"/>
				</textElement>
				<text><![CDATA[7. ಲೈಸೆನ್ಸ್‌ ಹೊಂದಿರುವ ಖರೀದಿಸುವ /ಪ್ರತಿನಿಧಿಯ ಸಹಿ]]></text>
