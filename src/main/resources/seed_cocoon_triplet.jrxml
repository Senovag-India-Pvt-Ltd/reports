			<staticText>
				<reportElement x="-5" y="598" width="213" height="38" uuid="1e20a0fd-025c-4f23-8ee6-748af50ea0d0">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="6" isBold="true"/>
				</textElement>
				<text><![CDATA[ ಸೂಚನೆ :- ರೇಷ್ಮೆ   ಹುಳು ಸಾಕಾಣಿಕೆದಾರ /ಗೂಡು ಕೊಳ್ಳುವ  ಗೂಡುಗಳನ್ನು  ಮಾರಾಟ ಮಡಿದ ಬಗ್ಗೆ   ನೀಡಿದ ಪ್ರಮಾಣ ಪತ್ರವನ್ನು   ಕನಿಷ್ಠ ಪಕ್ಷ ಜಾರಿ ಮಾಡಿದ ದಿನದಿಂದ 60 ದಿನಗಳವರೆಗೆ ಕಾಯಿರಿಸಬೇಕು . ಹಾಗೂ ರೇಷ್ಮೆ   ಇಲಾಖೆಯ ನಿರೀಕ್ಷಣಾ ಅಧಿಕಾರಿಗಳು ಅದನ್ನು   ಕೇಳಿದಾಗ ಹಾಜರುಪಡಿಸತಕದ್ದು ]]></text>
			</staticText>
			<staticText>
				<reportElement x="-5" y="84" width="213" height="36" uuid="2169f6c7-3a0d-4856-8f35-2fe2d8fae311">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="6"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<text><![CDATA[ಕರ್ನಾಟಕ ಸಿಲ್ಕ್  ವರ್ಮ್ ಸೀಡ್, ಕಕೂನ್  ಅಂಡ್ ಸಿಲ್ಕ್  ಯಾರ್ನ್ (ರೆಗ್ಯುಲೇಷನ್‌  ಆಫ್ ಪ್ರೊಡಕ್ಸನ್‌, ಸಪ್ಲೈ ,  ಡಿಸ್ಟ್ರಿಬ್ಯೂಸನ್‌    ಅಂಡ್ ಸೇಲ್ಸ್‌  )
ರೂಲ್ಸ್‌ ೧೯೬೦ - ಫಾರಂ ೭ಬಿ]]></text>
