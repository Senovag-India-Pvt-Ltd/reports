				</textElement>
				<text><![CDATA[ರೇಷ್ಮೆ    ಇಲಾಖೆ]]></text>
			</staticText>
			<staticText>
				<reportElement x="310" y="110" width="180" height="29" uuid="960eb026-1f0d-4dde-b9e7-bba78fbff16c"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[ಸರಕು   ರವಾನೆಯ  ಬೆಲೆ   ಪಟ್ಟಿ]]></text>
			</staticText>
			<staticText>
				<reportElement x="346" y="214" width="110" height="29" uuid="f74a0295-d35f-42e3-b85f-af0bc2510a5a"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[ತ್ರಿಪ್ರತಿಯಲ್ಲಿ]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="245" width="763" height="40" uuid="3fbddc78-5569-45d2-bb31-537731f715d8"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="11" isBold="false"/>
				</textElement>
				<text><![CDATA[ಈ  ಕೆಳಕಂಡ  ಸರಕನ್ನು     ಈ   ದಿನ  ವ್ಯಾನು , ಬಂಡಿ  ನೋಂದಣಿ  ಅಂಚೆ ,  ನೋಂದಣಿಯಾಗದ   ಮುದ್ದಾಂ    ಮೂಲಕ  ರವಾನಿಸಿದೆ.  ಇದರ   ತ್ರಿಪ್ರತಿಯಲ್ಲಿ                ಸರಕು  ತಲುಪಿದ್ದಕ್ಕೆ     ಇದರ  ಮೂರನೇ  ಪ್ರತಿಯಲ್ಲಿ     ಸಹಿ   ಮಾಡಿ  ದಯವಿಟ್ಟು     ವಾಪಾಸ್   ಕಳಿಸಿ]]></text>
			</staticText>
			<staticText>
				<reportElement x="21" y="794" width="711" height="30" uuid="015d5b2d-4588-4eb7-be15-dd1baf614452"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Nirmala UI"/>
				</textElement>
				<text><![CDATA[ಮೇಲಿನ   ಸರಕು  ಸುಸ್ಥಿತಿಯಲ್ಲಿ      ತಲುಪಿದೆ .   ಅದನ್ನು      ಈ     ಸಂಸ್ಥೆಯ  ಸಂಬಂದಪಟ್ಟ     ದಾಸ್ತಾನು  ಪುಸ್ತಕದಲ್ಲಿ      ನಮೂದಿಸಲಾಗಿದೆ . ]]></text>
			</staticText>
