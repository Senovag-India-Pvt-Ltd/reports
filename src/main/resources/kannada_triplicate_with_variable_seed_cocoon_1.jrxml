				</box>
				<textElement verticalAlignment="Bottom">
					<font fontName="Nirmala UI" size="6.5"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<text><![CDATA[ ೫. ಮಾರುಕಟ್ಟೆಗೆ ಪಾವತಿಸಬೇಕಾದ ಶುಲ್ಕ ರೂ]]></text>
			</staticText>
			<staticText>
				<reportElement x="-6" y="392" width="113" height="20" uuid="16baca58-10ee-452b-aa23-e32c3388c026">
