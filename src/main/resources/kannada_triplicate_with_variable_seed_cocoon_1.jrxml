					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="6.5"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<text><![CDATA[ ೬.  ರೇಷ್ಮೆ ಹುಳು ಸಾಕಾಣಿಕೆದಾರ  /ಪ್ರತಿನಿಧಿಗೆ ಪಾವತಿಸಬೇಕಾದ ಹಣ ರೂ

]]></text>
			</staticText>
			<staticText>
				<reportElement x="-6" y="412" width="113" height="20" uuid="20e8f2ef-7c14-4d14-9b4e-fd37fe07a330">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="6"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<text><![CDATA[೭.ರೇಷ್ಮೆ ಹುಳು ಸಾಕಾಣಿಕೆದಾರ/ ಪ್ರತಿನಿಧಿಯ ಸಹಿ]]></text>
			</staticText>
			<staticText>
				<reportElement x="-6" y="432" width="113" height="20" uuid="8a7e5609-f955-4d69-aef1-f3e2e5c4a94e">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="6.5"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<text><![CDATA[೮. ಲೈಸೆನ್ಸ್‌ ಹೊಂದಿರುವ ಖರೀದಿಸುವ /ಪ್ರತಿನಿಧಿಯ ಸಹಿ]]></text>
			</staticText>
			<staticText>
				<reportElement x="538" y="510" width="213" height="38" uuid="4b321df9-4433-48e2-81dd-774ff68d78bc">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="6" isBold="true"/>
				</textElement>
				<text><![CDATA[ ಸೂಚನೆ :- ರೇಷ್ಮೆ   ಹುಳು ಸಾಕಾಣಿಕೆದಾರ /ಗೂಡು ಕೊಳ್ಳುವ  ಗೂಡುಗಳನ್ನು  ಮಾರಾಟ ಮಡಿದ ಬಗ್ಗೆ   ನೀಡಿದ ಪ್ರಮಾಣ ಪತ್ರವನ್ನು   ಕನಿಷ್ಠ ಪಕ್ಷ ಜಾರಿ ಮಾಡಿದ ದಿನದಿಂದ 60 ದಿನಗಳವರೆಗೆ ಕಾಯಿರಿಸಬೇಕು . ಹಾಗೂ ರೇಷ್ಮೆ   ಇಲಾಖೆಯ ನಿರೀಕ್ಷಣಾ ಅಧಿಕಾರಿಗಳು ಅದನ್ನು   ಕೇಳಿದಾಗ ಹಾಜರುಪಡಿಸತಕದ್ದು ]]></text>
			</staticText>
			<staticText>
				<reportElement x="-6" y="510" width="213" height="38" uuid="fdec3497-5e3a-4afe-8ca0-a98ad918e776">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Nirmala UI" size="6" isBold="true"/>
				</textElement>
				<text><![CDATA[ ಸೂಚನೆ :- ರೇಷ್ಮೆ   ಹುಳು ಸಾಕಾಣಿಕೆದಾರ /ಗೂಡು ಕೊಳ್ಳುವ  ಗೂಡುಗಳನ್ನು  ಮಾರಾಟ ಮಡಿದ ಬಗ್ಗೆ   ನೀಡಿದ ಪ್ರಮಾಣ ಪತ್ರವನ್ನು   ಕನಿಷ್ಠ ಪಕ್ಷ ಜಾರಿ ಮಾಡಿದ ದಿನದಿಂದ 60 ದಿನಗಳವರೆಗೆ ಕಾಯಿರಿಸಬೇಕು . ಹಾಗೂ ರೇಷ್ಮೆ   ಇಲಾಖೆಯ ನಿರೀಕ್ಷಣಾ ಅಧಿಕಾರಿಗಳು ಅದನ್ನು   ಕೇಳಿದಾಗ ಹಾಜರುಪಡಿಸತಕದ್ದು ]]></text>
			</staticText>
